{
  "name": "efs-contracts",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "node tools/checks.mjs",
    "vectors": "node tools/vectors.mjs",
    "layout": "node tools/layout.mjs",
    "layout:check": "node tools/layout.mjs --check",
    "abi:snapshot": "node tools/abi-snapshot.mjs",
    "abi:check": "node tools/abi-snapshot.mjs --check",
    "release": "node tools/release.mjs",
    "release:check": "node tools/release.mjs --check 1",
    "plan": "node tools/deploy-plan.mjs",
    "fixture:up": "node tools/efs-fixture.mjs up",
    "fixture:verify": "node tools/efs-fixture.mjs verify",
    "fixture:down": "node tools/efs-fixture.mjs down",
    "fixture:status": "node tools/efs-fixture.mjs status",
    "fixture:list": "node tools/efs-fixture.mjs list",
    "fixture:reset": "node tools/efs-fixture.mjs reset",
    "fixture:gc": "node tools/efs-fixture.mjs gc",
    "fixture:snapshot": "node tools/artifacts-snapshot.mjs",
    "gas:report": "node tools/gas-report.mjs",
    "gas:model": "node tools/gas-model.mjs",
    "test:tools": "node --test \"tools/test/*.test.mjs\""
  },
  "devDependencies": {
    "viem": "2.57.7"
  }
}
