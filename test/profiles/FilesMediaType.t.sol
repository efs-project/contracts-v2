pragma solidity 0.8.37;

import {IAcceptor, AcceptContext, RefHeader} from "../../src/interfaces/IAcceptor.sol";
import {FilesProfile, E_FILES_REFUSED} from "../../src/profiles/FilesProfile.sol";
import {FilesContentRule} from "../../src/profiles/FilesContentRule.sol";
import {FilesExternalContentRule} from "../../src/profiles/FilesExternalContentRule.sol";
import {EfsFiles} from "../../src/lib/EfsFiles.sol";
import {Keys} from "../../src/lib/Keys.sol";
import {Genesis} from "../../script/Genesis.s.sol";
import {FilesUnitBase} from "./FilesUnitBase.sol";

/// `FilesProfile.mediaTypeRefusal` behind an external call (it reads calldata).
contract MediaTypeProbe {
    function refusal(bytes calldata m) external pure returns (uint256) {
        return FilesProfile.mediaTypeRefusal(m);
    }
}

/// @notice The media-type grammar of `files-content/1` and `files-external/1` (docs/LARGE-FILES.md "Media types"):
///         the shared `FilesProfile.mediaTypeRefusal` on the listed valid and refused strings, a fuzzed
///         differential against a byte-at-a-time reference written here from the NatSpec, both rules' media laws
///         (the length words, the tails, the grammar codes), the rules' validation gas per string, and the
///         committed vectors (`test/vectors/media.json`, generated by `tools/media-vectors.mjs` through
///         `pnpm release`) against the grammar, both rules, `EfsFiles`, `Keys` and the release Type ids.
contract FilesMediaTypeTest is FilesUnitBase {
    MediaTypeProbe internal probe;
    FilesContentRule internal content;
    FilesExternalContentRule internal ext;

    bytes32 internal constant BYTES_TYPE = keccak256("test/files/bytes-type");
    bytes32 internal constant SPAN_TYPE = keccak256("test/files/span-type");
    bytes32 internal constant BYTES_REF = keccak256("a files-bytes/1 record");
    bytes internal constant LOCATOR = "ar://bNbA3TEQVL60xlgCcqdz4ZPHFZ711cZ3hmkpGttDt_U";
    bytes internal constant DOCX =
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

    function setUp() public override {
        super.setUp();
        probe = new MediaTypeProbe();
        content = new FilesContentRule(BYTES_TYPE, SPAN_TYPE);
        ext = new FilesExternalContentRule();
    }

    // ---- the reference (byte at a time, from the NatSpec) ------------------------------------------------------

    function _first(uint8 c) internal pure returns (bool) {
        return (c >= 0x61 && c <= 0x7a) || (c >= 0x30 && c <= 0x39);
    }

    function _nameByte(uint8 c) internal pure returns (bool) {
        return _first(c) || c == 0x21 || c == 0x23 || c == 0x24 || c == 0x26 || c == 0x2d
            || c == 0x5e || c == 0x5f || c == 0x2e || c == 0x2b;
    }

    /// The end of the name at `i`, or type(uint256).max when there is none.
    function _refName(bytes memory m, uint256 i) internal pure returns (uint256) {
        if (i >= m.length || !_first(uint8(m[i]))) return type(uint256).max;
        uint256 j = i + 1;
        while (j < m.length && _nameByte(uint8(m[j]))) ++j;
        return j - i > 127 ? type(uint256).max : j;
    }

    function _reference(bytes memory m) internal pure returns (uint256) {
        if (m.length == 0) return 0;
        if (m.length > 255) return 1;
        uint256 t = _refName(m, 0);
        if (t == type(uint256).max) return 2;
        if (t >= m.length || m[t] != "/") return 3;
        uint256 s = _refName(m, t + 1);
        if (s == type(uint256).max) return 4;
        if (s == m.length) return 0;
        if (m[s] != ";") return 5;
        for (uint256 i = s + 1; i < m.length; ++i) {
            if (uint8(m[i]) < 0x20 || uint8(m[i]) > 0x7e) return 6;
        }
        return 0;
    }

    // ---- bodies --------------------------------------------------------------------------------------------------

    function _content(bytes memory media) internal pure returns (bytes memory) {
        return EfsFiles.contentBody(BYTES_REF, 0, 1, sha256(hex"ff"), media);
    }

    function _external(bytes memory media) internal pure returns (bytes memory) {
        return EfsFiles.externalBody(BYTES_REF, 5, sha256("x"), LOCATOR, media);
    }

    function _bytesHeader() internal pure returns (RefHeader[] memory) {
        return _header(BYTES_TYPE, 33, sha256(hex"ff"), 0, 0);
    }

    function _sentinel() internal pure returns (RefHeader[] memory) {
        return _header(BYTES_TYPE, 32, sha256(""), 0, 0);
    }

    function _contentCode(bytes memory body) internal returns (uint8) {
        return _codeOf(content, body, _bytesHeader());
    }

    function _externalCode(bytes memory body) internal returns (uint8) {
        return _codeOf(ext, body, _sentinel());
    }

    /// 0 when the rule accepts, else its `E_FILES_REFUSED` code.
    function _codeOf(IAcceptor rule, bytes memory body, RefHeader[] memory h)
        internal
        returns (uint8)
    {
        (bool ok, bytes memory ret) = _call(rule, _ctx(), body, _one(BYTES_REF), h);
        if (ok) {
            assertEq(bytes4(ret), IAcceptor.accept.selector);
            return 0;
        }
        assertEq(ret.length, 36, "an E_FILES_REFUSED(code)");
        assertEq(bytes4(ret), E_FILES_REFUSED.selector);
        return uint8(uint256(_word(ret, 4)));
    }

    function _word(bytes memory b, uint256 at) internal pure returns (bytes32 w) {
        assembly ("memory-safe") {
            w := mload(add(add(b, 32), at))
        }
    }

    /// `n` copies of `c`.
    function _run(uint256 n, bytes1 c) internal pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i; i < n; ++i) {
            out[i] = c;
        }
    }

    /// The grammar's code for `m`, the reference's, and both rules' verdicts.
    function _expect(bytes memory m, uint256 code) internal {
        assertEq(probe.refusal(m), code, string(m));
        assertEq(_reference(m), code, "reference");
        uint8 c = code == 0 ? 0 : (m.length > 255 ? 11 : 12);
        uint8 x = code == 0 ? 0 : (m.length > 255 ? 8 : 9);
        assertEq(_contentCode(_content(m)), c, "files-content/1");
        assertEq(_externalCode(_external(m)), x, "files-external/1");
    }

    // ---- admitted ------------------------------------------------------------------------------------------------

    function test_valid_media_types_are_admitted() public {
        _expect("", 0);
        _expect("image/png", 0);
        _expect("text/html; charset=utf-8", 0);
        _expect("text/html;charset=utf-8", 0);
        _expect(DOCX, 0);
        _expect('video/mp4; codecs="avc1.42E01E, mp4a.40.2"', 0);
        _expect("application/x.foo+json", 0);
        _expect("a0!#$&-^_.+/z9!#$&-^_.+", 0); // every restricted-name byte after the first
        _expect("3gpp/1d-interleaved-parityfec", 0); // a digit first
        _expect("text/plain; x=a/b", 0); // a slash after ';'
        _expect("text/plain;", 0); // nothing after ';': the parameters are not parsed
        _expect("text/plain; a=~ !", 0); // 0x7e and 0x20 are the bounds
        // the 255-byte maximum: 127 + 1 + 127
        bytes memory max = bytes.concat(_run(127, "a"), "/", _run(127, "b"));
        assertEq(max.length, 255);
        _expect(max, 0);
        _expect(bytes.concat(_run(127, "a"), "/b"), 0);
        _expect(bytes.concat("a/", _run(127, "b")), 0);
    }

    // ---- refused -------------------------------------------------------------------------------------------------

    function test_invalid_media_types_are_refused() public {
        _expect("Image/png", 2); // uppercase in the type: never normalized on chain
        _expect("image/PNG", 4); // uppercase in the subtype
        _expect("imagE/png", 3);
        _expect("image/pNg", 5);
        _expect("textplain", 3); // no slash
        _expect("text/plain/x", 5); // two slashes before ';'
        _expect("/plain", 2); // empty type
        _expect("text/", 4); // empty subtype
        _expect(" text/plain", 2); // leading space
        _expect("text/plain ; charset=utf-8", 5); // space before ';'
        _expect("text/plain\t; charset=utf-8", 5);
        _expect("text/*", 4); // no wildcards
        _expect("*/*", 2);
        _expect("-x/y", 2);
        _expect(hex"746578742f706c61696e3b0d0a", 6); // CR LF after ';'
        _expect(hex"746578742f706c61696e3b00", 6); // a control byte
        _expect(hex"746578742f706c61696e3b7f", 6); // 0x7f
        _expect(hex"746578742f706c61696e3b80", 6); // a byte at or above 0x80
        _expect(hex"746578742f706c61696e3bff", 6);
        _expect(hex"746578742f706cff", 5);
        _expect(bytes.concat(_run(128, "a"), "/b"), 2); // a 128-byte type
        _expect(bytes.concat("a/", _run(128, "b")), 4); // a 128-byte subtype
        _expect(bytes.concat(_run(127, "a"), "/", _run(127, "b"), ";"), 1); // 256 bytes
    }

    function test_media_length_word_must_be_the_tail() public {
        bytes memory c = _content("image/png");
        assertEq(_contentCode(bytes.concat(c, "x")), 2, "trailing bytes after the tail");
        bytes memory short = new bytes(c.length - 1);
        for (uint256 i; i < short.length; ++i) {
            short[i] = c[i];
        }
        assertEq(_contentCode(short), 2, "a tail shorter than mediaLength");
        c[223] = bytes1(uint8(10)); // mediaLength 10 over a 9-byte tail
        assertEq(_contentCode(c), 2);
        c[223] = bytes1(uint8(8)); // mediaLength 8: the ninth byte is trailing
        assertEq(_contentCode(c), 2);
        c = _content("");
        c[222] = 0x01; // mediaLength 256 is refused by the length bound before the body length
        assertEq(_contentCode(c), 11);
        c[192] = 0xff; // a huge mediaLength never overflows
        assertEq(_contentCode(c), 11);
        assertEq(_contentCode(new bytes(351)), 2, "shorter than the eleven words");

        bytes memory x = _external("image/png");
        assertEq(_externalCode(bytes.concat(x, "x")), 5, "trailing bytes after the tail");
        x[255] = bytes1(uint8(10));
        assertEq(_externalCode(x), 5);
        x = _external("");
        x[254] = 0x01; // mediaLength 256
        assertEq(_externalCode(x), 8);
        x[224] = 0xff; // a huge mediaLength
        assertEq(_externalCode(x), 8);
        assertEq(_externalCode(new bytes(255)), 2, "shorter than the eight words");
        // the locator check stops at the locator: a media tail is never read as locator bytes
        x = _external("text/plain; a=b");
        assertEq(_externalCode(x), 0);
        // and the media check starts after it: a locator byte is never read as media
        x = EfsFiles.externalBody(BYTES_REF, 5, sha256("x"), "a:B", "");
        assertEq(_externalCode(x), 0);
    }

    function test_encrypted_content_may_declare_or_withhold_its_type() public {
        bytes memory ct = new bytes(17);
        for (uint256 k; k < 2; ++k) {
            bytes memory media = k == 0 ? bytes("") : bytes("text/plain");
            EfsFiles.Content memory c = EfsFiles.Content({
                bytesRef: BYTES_REF,
                version: 1,
                carrier: 0,
                hashAlg: 1,
                length: 17,
                sha256Digest: sha256(ct),
                media: media,
                cipher: 1,
                nonce12: bytes32(bytes12(keccak256("nonce"))),
                plaintextLength: 1,
                plaintextSha256OrZero: 0
            });
            assertEq(
                _codeOf(
                    content, EfsFiles.contentBody(c), _header(BYTES_TYPE, 49, sha256(ct), 0, 0)
                ),
                0
            );
        }
    }

    // ---- fuzzed differential -------------------------------------------------------------------------------------

    /// A string over an alphabet that reaches every branch: name bytes, `/`, `;`, space, tab, uppercase, `*`,
    /// 0x7e, 0x7f, 0x80 and NUL.
    function _shaped(bytes memory seed) internal pure returns (bytes memory m) {
        bytes memory alphabet = hex"61627a30392f3b2009415a2a7e7f80002d2b2e5f21";
        m = new bytes(seed.length);
        for (uint256 i; i < seed.length; ++i) {
            m[i] = alphabet[uint8(seed[i]) % alphabet.length];
        }
    }

    function testFuzz_grammar_matches_the_reference(bytes calldata seed, bool raw) public {
        bytes memory m = raw ? seed : _shaped(seed);
        if (m.length > 300) m = _shaped(seed[:300]);
        uint256 code = _reference(m);
        assertEq(probe.refusal(m), code);
    }

    function testFuzz_valid_shapes_are_admitted(uint8 typeLen, uint8 subLen, bytes calldata params)
        public
        view
    {
        uint256 t = 1 + uint256(typeLen) % 127;
        uint256 s = 1 + uint256(subLen) % 127;
        bytes memory m = bytes.concat(_run(t, "x"), "/", _run(s, "y"));
        if (params.length != 0 && m.length < 254) {
            bytes memory p = new bytes(_min(params.length, 254 - m.length));
            for (uint256 i; i < p.length; ++i) {
                p[i] = bytes1(uint8(0x20 + uint8(params[i]) % 95)); // printable
            }
            m = bytes.concat(m, ";", p);
        }
        assertEq(probe.refusal(m), 0);
    }

    function _min(uint256 a, uint256 b) internal pure returns (uint256) {
        return a < b ? a : b;
    }

    // ---- validation gas ------------------------------------------------------------------------------------------

    /// The rules' own validation gas (the `accept` frame, `vm.lastCallGas`) for a one-byte inline descriptor and the
    /// 48-byte `ar://` location, each with the media tail: logged `media accept gas <rule> <label>`.
    function test_validation_gas_per_media_type() public {
        bytes[5] memory media = [
            bytes(""),
            bytes("image/png"),
            bytes("text/html; charset=utf-8"),
            DOCX,
            bytes.concat(_run(127, "a"), "/", _run(127, "b"))
        ];
        string[5] memory labels = ["empty", "png 9", "html 24", "docx 71", "max 255"];
        bytes32[] memory refs = _one(BYTES_REF);
        AcceptContext memory ctx = _ctx();
        for (uint256 i; i < 5; ++i) {
            bytes memory c = _content(media[i]);
            RefHeader[] memory h = _bytesHeader();
            vm.prank(address(stub));
            content.accept(ctx, c, refs, h);
            uint256 used = vm.lastCallGas().gasTotalUsed;
            emit log_named_uint(string.concat("media accept gas content ", labels[i]), used);
            assertLt(used, 300_000, "inside the closure default acceptor budget");
            bytes memory x = _external(media[i]);
            h = _sentinel();
            vm.prank(address(stub));
            ext.accept(ctx, x, refs, h);
            used = vm.lastCallGas().gasTotalUsed;
            emit log_named_uint(string.concat("media accept gas external ", labels[i]), used);
            assertLt(used, 300_000, "inside the closure default acceptor budget");
        }
    }

    // ---- the committed vectors (test/vectors/media.json) ---------------------------------------------------------

    function test_media_vectors_match_the_grammar_and_both_rules() public {
        string memory json = vm.readFile("test/vectors/media.json");
        uint256 n = _count(json, ".rules");
        assertGt(n, 30);
        for (uint256 i; i < n; ++i) {
            string memory at = string.concat(".rules[", vm.toString(i), "]");
            uint256 code = vm.parseJsonUint(json, string.concat(at, ".grammarCode"));
            bytes memory m = vm.parseJsonBytes(json, string.concat(at, ".mediaHex"));
            string memory label = vm.parseJsonString(json, string.concat(at, ".label"));
            assertEq(vm.parseJsonUint(json, string.concat(at, ".length")), m.length, label);
            assertEq(probe.refusal(m), code, label);
            assertEq(vm.parseJsonBool(json, string.concat(at, ".accepted")), code == 0, label);
            assertEq(
                _contentCode(_content(m)),
                vm.parseJsonUint(json, string.concat(at, ".contentRuleCode")),
                label
            );
            assertEq(
                _externalCode(_external(m)),
                vm.parseJsonUint(json, string.concat(at, ".externalRuleCode")),
                label
            );
        }
    }

    /// The length of the JSON array at `path`.
    function _count(string memory json, string memory path) internal view returns (uint256 n) {
        while (vm.keyExistsJson(json, string.concat(path, "[", vm.toString(n), "]"))) ++n;
    }

    function test_media_vectors_encodings_and_ids() public {
        string memory json = vm.readFile("test/vectors/media.json");
        uint256 n = _count(json, ".encoding");
        assertGe(n, 6);
        bytes32 contentType = vm.parseJsonBytes32(json, '.typeIds["files-content/1"]');
        bytes32 externalType = vm.parseJsonBytes32(json, '.typeIds["files-external/1"]');
        for (uint256 i; i < n; ++i) {
            string memory at = string.concat(".encoding[", vm.toString(i), "]");
            string memory label = vm.parseJsonString(json, string.concat(at, ".label"));
            bytes memory want = vm.parseJsonBytes(json, string.concat(at, ".body"));
            bytes memory media = vm.parseJsonBytes(json, string.concat(at, ".inputs.mediaHex"));
            bytes32 typeId = vm.parseJsonBytes32(json, string.concat(at, ".typeId"));
            bytes memory body;
            if (
                keccak256(bytes(vm.parseJsonString(json, string.concat(at, ".type"))))
                    == keccak256("files-content/1")
            ) {
                assertEq(typeId, contentType, label);
                body = EfsFiles.contentBody(
                    vm.parseJsonBytes32(json, string.concat(at, ".inputs.bytesRef")),
                    vm.parseJsonUint(json, string.concat(at, ".inputs.carrier")),
                    vm.parseJsonUint(json, string.concat(at, ".inputs.length")),
                    vm.parseJsonBytes32(json, string.concat(at, ".inputs.sha256")),
                    media
                );
                assertEq(_contentCode(_content(media)), 0, label);
            } else {
                assertEq(typeId, externalType, label);
                body = EfsFiles.externalBody(
                    vm.parseJsonBytes32(json, string.concat(at, ".inputs.sentinel")),
                    vm.parseJsonUint(json, string.concat(at, ".inputs.length")),
                    vm.parseJsonBytes32(json, string.concat(at, ".inputs.sha256")),
                    bytes(vm.parseJsonString(json, string.concat(at, ".inputs.locator"))),
                    media
                );
                assertEq(_externalCode(_external(media)), 0, label);
            }
            assertEq(body, want, label);
            assertEq(vm.parseJsonUint(json, string.concat(at, ".bodyLength")), body.length, label);
            assertEq(
                Keys.record(typeId, body),
                vm.parseJsonBytes32(json, string.concat(at, ".recordId")),
                label
            );
        }
    }

    /// The vectors' Type ids are the release's: the ten rules deployed and described by `script/Genesis.s.sol` for
    /// the declaration key give the same ids. Only the release profile compiles the release bytes, so another
    /// profile (amsterdam) skips this one comparison.
    function test_media_vectors_name_the_release_type_ids() public {
        if (
            keccak256(bytes(vm.envOr("FOUNDRY_PROFILE", string("default"))))
                == keccak256("amsterdam")
        ) {
            return;
        }
        string memory json = vm.readFile("test/vectors/media.json");
        address key = vm.parseJsonAddress(json, ".declarationKey");
        (,,, bytes32[10] memory typeIds,,,) = new Genesis().profile(key);
        assertEq(typeIds[4], vm.parseJsonBytes32(json, '.typeIds["files-bytes/1"]'));
        assertEq(typeIds[5], vm.parseJsonBytes32(json, '.typeIds["files-content/1"]'));
        assertEq(typeIds[6], vm.parseJsonBytes32(json, '.typeIds["files-external/1"]'));
    }
}
