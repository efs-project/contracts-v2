{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "efs-deployment/1",
  "title": "efs-deployment/1 \u2014 one Realm's deployment manifest (design \u00a713)",
  "description": "Written by tools/efs-fixture.mjs up; every value is reproduced by tools/efs-fixture.mjs verify from the artifacts and the chain. Hex values are 0x-prefixed; bigints are decimal strings.",
  "type": "object",
  "required": [
    "schema",
    "releaseDigest",
    "planHash",
    "chainId",
    "realmId",
    "realmOrigin",
    "realmSalt",
    "factory",
    "genesis",
    "activation",
    "layoutId",
    "hotAbiId",
    "executionProfileId",
    "limits",
    "limitsProfileId",
    "domainSeparator",
    "noticePrincipal",
    "ledger",
    "registry",
    "controller",
    "proxies",
    "contracts",
    "index",
    "typeIds",
    "profile",
    "privilegedRoles",
    "readers",
    "seed",
    "root",
    "defaultLensPrincipals",
    "actors",
    "rpc",
    "chain",
    "evidenceGrade",
    "hotAbiIdString"
  ],
  "properties": {
    "schema": {
      "const": "efs-deployment/1"
    },
    "releaseDigest": {
      "type": [
        "string",
        "null"
      ],
      "description": "sha256(release/release.json) at up time; null when no release manifest existed"
    },
    "planHash": {
      "type": "string",
      "description": "keccak256 of deploy/plan.json's canonical body (tools/deploy-plan.mjs planDocument)"
    },
    "chainId": {
      "type": "integer"
    },
    "realmId": {
      "type": "string"
    },
    "realmOrigin": {
      "type": "string"
    },
    "realmSalt": {
      "type": "string"
    },
    "factory": {
      "type": "object",
      "required": [
        "address",
        "method",
        "runtimeCodehash"
      ],
      "properties": {
        "method": {
          "enum": [
            "presigned-tx",
            "anvil_setCode",
            "preexisting"
          ]
        }
      }
    },
    "genesis": {
      "type": "object",
      "required": [
        "address",
        "nonces",
        "txHash",
        "blockNumber"
      ]
    },
    "activation": {
      "type": "object",
      "required": [
        "revision",
        "executionSet",
        "txHash",
        "blockNumber",
        "capabilities",
        "acceptedChainId",
        "set"
      ]
    },
    "ledger": {
      "type": "string"
    },
    "registry": {
      "type": "string"
    },
    "controller": {
      "type": "object",
      "required": [
        "address",
        "owner",
        "pendingOwner",
        "frozen"
      ]
    },
    "proxies": {
      "type": "object",
      "required": [
        "ledger",
        "registry"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "address",
          "implementation",
          "proxyAdmin",
          "proxyAdminOwner",
          "immutableReferences",
          "initializer"
        ]
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "address",
          "runtimeCodehash",
          "step"
        ]
      }
    },
    "index": {
      "type": "object",
      "required": [
        "address",
        "runtimeCodehash",
        "reads",
        "generation",
        "manifestHash",
        "indexObligations",
        "stores",
        "families",
        "units",
        "digestSpecs",
        "workModel"
      ],
      "properties": {
        "runtimeCodehash": { "type": "string", "description": "keccak256 of the generation's runtime code (its immutables name the reads contract and its codehash)" },
        "reads": {
          "type": "object",
          "required": ["address", "runtimeCodehash"],
          "description": "the generation's IndexReads: its manifest and every read the generation forwards (design §10.1)"
        }
      }
    },
    "typeIds": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "profile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "typeId",
          "rule",
          "instance",
          "ruleCodehash",
          "ruleInitcodeHash",
          "refTypes",
          "shape",
          "blob"
        ]
      }
    },
    "readers": {
      "type": "object",
      "required": [
        "ledgerReads",
        "ledgerViews",
        "readerDirectory",
        "lensReader",
        "filesPageReader",
        "topicMineReader",
        "topicEveryoneReader",
        "topicLookupReader",
        "web3Gateway",
        "listed"
      ],
      "properties": {
        "web3Gateway": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "resolveMode",
            "rootDirectory",
            "urlBase",
            "seedUrl",
            "ledger",
            "content"
          ],
          "properties": {
            "resolveMode": {
              "const": "5219"
            },
            "content": {
              "type": "object",
              "description": "The EfsWeb3Content the gateway reaches by STATICCALL: its address and runtime codehash, as the gateway's CONTENT / CONTENT_CODEHASH immutables record them.",
              "required": [
                "address",
                "runtimeCodehash"
              ]
            }
          }
        },
        "lensReader": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "kind",
            "ledger",
            "views",
            "reads",
            "layoutId"
          ]
        },
        "filesPageReader": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "kind",
            "ledger",
            "views",
            "reads",
            "layoutId",
            "nameType",
            "rootType",
            "childType"
          ]
        },
        "topicMineReader": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "kind",
            "ledger",
            "views",
            "reads",
            "layoutId"
          ]
        },
        "topicEveryoneReader": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "kind",
            "ledger",
            "views",
            "reads",
            "layoutId"
          ]
        },
        "topicLookupReader": {
          "type": "object",
          "required": [
            "address",
            "runtimeCodehash",
            "kind",
            "ledger",
            "views",
            "reads",
            "layoutId",
            "topicType",
            "wordType"
          ]
        },
        "listed": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ordinal",
              "reader",
              "codehash",
              "layoutId",
              "physicalProfile"
            ]
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "required": [
        "version",
        "transactions"
      ]
    },
    "root": {
      "type": "object",
      "description": "The Realm root folder: its files-directory/1 record id (abi.encode(principalId, rootSalt) under the directory Type) and the principal that published it. A folder is a record, never a subject, so there is no subject id.",
      "required": [
        "directoryRecordId",
        "principalId"
      ]
    },
    "defaultLensPrincipals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "actors": {
      "type": "object",
      "required": [
        "owner",
        "fixturePrincipal",
        "declarationKey"
      ]
    },
    "chain": {
      "type": "object",
      "description": "What the chain enforced when this deployment was made: a snapshot, not live truth. txGasCap is the EIP-7825 per-transaction gas limit cap, or null where nothing enforces one; blockGasLimit is the latest block's at deployment. A client reads live values and uses these as defaults.",
      "required": [
        "hardfork",
        "feeSchedule",
        "txGasCap",
        "txGasCapEnforced",
        "blockGasLimit"
      ],
      "properties": {
        "txGasCapEnforced": {
          "type": "boolean"
        },
        "blockGasLimit": {
          "type": "integer"
        }
      }
    },
    "rpc": {
      "type": "object",
      "required": [
        "url",
        "chainId"
      ]
    },
    "signerCapable": {
      "type": "boolean",
      "description": "true when the node holds unlocked accounts (eth_sendTransaction works without a wallet); false when it was started with no unlocked accounts (efs-fixture up --no-unlocked). Every fixture transaction is signed locally either way."
    },
    "signing": {
      "type": "object",
      "required": [
        "transactions",
        "unlockedAccounts",
        "unsignedSend"
      ],
      "properties": {
        "transactions": {
          "type": "string"
        },
        "unlockedAccounts": {
          "type": "integer"
        },
        "unsignedSend": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "What this deployment offers a consumer: the Files seed version, the number of Files Types, the reader kind labels, signerCapable, the unlocked-account count, the hardfork.",
      "required": [
        "filesSeed",
        "filesTypes",
        "readers",
        "signerCapable"
      ],
      "properties": {
        "filesSeed": {
          "type": [
            "string",
            "null"
          ]
        },
        "filesTypes": {
          "type": "integer"
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signerCapable": {
          "type": "boolean"
        }
      }
    },
    "evidenceGrade": {
      "enum": [
        "local-fixture"
      ]
    }
  }
}
