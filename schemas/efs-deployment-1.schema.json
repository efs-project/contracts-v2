{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "efs-deployment/1",
  "title": "efs-deployment/1 — one Realm's deployment manifest (design §13)",
  "description": "Written by tools/efs-fixture.mjs up; every value is reproduced by tools/efs-fixture.mjs verify from the artifacts and the chain. Hex values are 0x-prefixed; bigints are decimal strings.",
  "type": "object",
  "required": ["schema", "releaseDigest", "planHash", "chainId", "realmId", "realmOrigin", "realmSalt", "factory", "genesis", "activation", "layoutId", "hotAbiId", "executionProfileId", "limits", "limitsProfileId", "domainSeparator", "noticePrincipal", "ledger", "registry", "controller", "proxies", "contracts", "index", "typeIds", "profile", "privilegedRoles", "readers", "seed", "root", "defaultLensPrincipals", "actors", "rpc", "evidenceGrade"],
  "properties": {
    "schema": { "const": "efs-deployment/1" },
    "releaseDigest": { "type": ["string", "null"], "description": "sha256(release/release.json) at up time; null when no release manifest existed" },
    "planHash": { "type": "string", "description": "keccak256 of deploy/plan.json's canonical body (tools/deploy-plan.mjs planDocument)" },
    "chainId": { "type": "integer" },
    "realmId": { "type": "string" },
    "realmOrigin": { "type": "string" },
    "realmSalt": { "type": "string" },
    "factory": { "type": "object", "required": ["address", "method", "runtimeCodehash"], "properties": { "method": { "enum": ["presigned-tx", "anvil_setCode", "preexisting"] } } },
    "genesis": { "type": "object", "required": ["address", "nonces", "txHash", "blockNumber"] },
    "activation": { "type": "object", "required": ["revision", "executionSet", "txHash", "blockNumber", "capabilities", "acceptedChainId", "set"] },
    "ledger": { "type": "string" },
    "registry": { "type": "string" },
    "controller": { "type": "object", "required": ["address", "owner", "pendingOwner", "frozen"] },
    "proxies": { "type": "object", "required": ["ledger", "registry"], "additionalProperties": { "type": "object", "required": ["address", "implementation", "proxyAdmin", "proxyAdminOwner", "immutableReferences", "initializer"] } },
    "contracts": { "type": "object", "additionalProperties": { "type": "object", "required": ["address", "runtimeCodehash", "step"] } },
    "index": { "type": "object", "required": ["address", "generation", "manifestHash", "indexObligations", "stores", "families", "units", "digestSpecs", "workModel"] },
    "typeIds": { "type": "object", "additionalProperties": { "type": "string" } },
    "profile": { "type": "array", "items": { "type": "object", "required": ["type", "typeId", "rule", "instance", "ruleCodehash", "ruleInitcodeHash", "refTypes", "shape", "blob"] } },
    "readers": { "type": "object", "required": ["ledgerReads", "ledgerViews", "readerDirectory", "listed"] },
    "seed": { "type": "object", "required": ["version", "transactions"] },
    "root": { "type": "object", "required": ["directoryRecordId", "subjectId", "principalId"] },
    "defaultLensPrincipals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "actors": { "type": "object", "required": ["owner", "fixturePrincipal", "declarationKey"] },
    "rpc": { "type": "object", "required": ["url", "chainId"] },
    "evidenceGrade": { "enum": ["local-fixture"] }
  }
}
