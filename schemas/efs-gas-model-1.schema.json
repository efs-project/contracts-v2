                "properties": {
                  "state": {
                    "enum": ["listsNew", "listsExist", "acrossPlaces", "acrossPlacesBitsWord", "withinClaim", "longLists", "beyondClaim"],
                    "description": "The state the composite is measured in: the author's lists at the positions it touches are new (listsNew) or already hold entries (listsExist, the ordinary case); for later statements: at distinct places with the author's lists at most laterLists.shortTierMaxEntries long (acrossPlaces), at entry 48 of a 49-entry list, alone in its bits word (acrossPlacesBitsWord), in lists longer than the short tier and shorter than the claim (withinClaim), in lists of laterLists.claimEntries + 1 entries (longLists, the floor's claim), or in longer lists (beyondClaim: reported with its errors, excluded from the stated maxima and from the 15% bound, maximaExcludeStates)."
                  }
                },
                "required": [
                  "key",
                  "state",
                  "what",
                  "measured",
                  "predicted",
                  "errorPercent",
                  "measuredKernelGas",
                  "predictedKernelGas"
                ]
              }
            },
            "maxAbsErrorPercent": {
              "type": "number",
              "description": "The largest |errorPercent| over the validation composites: all gas, which is what the EIP-7825 2^24 cap counts on this schedule."
            },
