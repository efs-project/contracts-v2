                    "required": [
                      "opening",
                      "perRow",
                      "perLensAuthor",
                      "perSkippedEntryByLens"
                    ]
                  },
                  "everyoneBelow": {
                    "type": "object",
                    "required": [
                      "opening",
                      "perRow",
                      "perLensAuthor",
                      "perSkippedEntryByLens"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "opening",
                    "perRow"
                  ]
                }
              },
              "bounds": {
                "type": "object",
                "description": "per lens size: the most rows (worst case) and skipped entries one call reads under the budget",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "mineExact",
                    "mineBelow",
                    "everyoneExact",
                    "everyoneBelow"
                  ]
                }
              },
              "recommended": {
                "type": "object",
                "required": [
                  "pageTimesLens",
                  "maxRows",
                  "limitEntries"
                ]
              }
            }
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "description": "The planning rule (tools/gas-plan.mjs is its reference implementation, reading only this file).",
      "required": [
        "rule",
        "txGasCap",
        "txGasCapRule",
        "headroomPercent",
        "headroomCovers",
        "limits"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "txGasCap": {
          "type": "integer"
        },
        "headroomPercent": {
          "type": "integer"
        },
        "limits": {
          "type": "object",
          "required": [
            "maxActions",
            "maxBindsPerPublication",
            "maxBodyBytesPerPublication"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "tagLists": {
      "type": "object",
      "description": "When a roll-up list's next append is priced as new (tagLevel.mineNew / sharedNew): entries \u2208 priceAsNew.entries or entries % priceAsNew.entriesMultipleOf == 0.",
      "required": [
        "priceAsNew",
        "note"
      ],
      "properties": {
        "priceAsNew": {
          "type": "object",
          "required": [
            "entries",
            "entriesMultipleOf"
          ],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "entriesMultipleOf": {
              "type": "integer"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "laterRows": {
      "type": "object",
      "description": "The measured statement position of every later row (tools/gas-plan.mjs historyWordAdds): rows maps a constants name to the head's revision before the measured statement, whether the binding's history list opened a word for it, and for a BIND whether it named the stored target, a new one or a head that never bound; rule says how a planner selects a row from the head view and corrects for another position (the profile's historyWordOpen constant).",
      "required": ["rule", "note", "historyWordConstant", "rows"],
      "properties": {
        "rule": { "type": "string" },
        "note": { "type": "string" },
        "historyWordConstant": { "type": "string" },
        "rows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["revisionBefore", "opensHistoryWord", "target"],
            "properties": {
              "revisionBefore": { "type": "integer" },
              "opensHistoryWord": { "type": "boolean" },
              "target": { "enum": ["same", "new", "neverBound", null] },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "laterLists": {
      "type": "object",
      "description": "The list tiers of later statements (tools/gas-plan.mjs laterKey): the short tier when the author's entry count at the place is known and at most shortTierMaxEntries; otherwise the rows measured at entry claimEntries (the cap of the claim, not a third tier).",
      "required": ["shortTierMaxEntries", "claimEntries", "rule", "note"],
      "properties": {
        "shortTierMaxEntries": { "type": "integer" },
        "claimEntries": { "type": "integer" },
        "rule": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
