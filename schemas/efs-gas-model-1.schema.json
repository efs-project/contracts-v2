{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "efs-gas-model/1",
  "title": "efs-gas-model/1 \u2014 a per-action gas model of one native-lane publication",
  "description": "Written by tools/gas-model.mjs from test/integration/GasModel.t.sol. gas(publication) = fixed + \u03a3 cost(action); PUBLISH new = publishNew[shape] + perWord\u00b7ceil(n/32) + perByte\u00b7n; a first TAG on an n-word topic adds tagLevel terms per proper ancestor. Planning only: eth_estimateGas stays the authority before sending. Excludes intrinsic, calldata and refunds. profiles.<schedule>.floor carries the kernel's index-floor quote inputs and the kernel's own share (design \u00a710.4); planning the rule a planner sizes a publication by: max(E, V) \u2264 floor(txGasCap \u00d7 (100 \u2212 headroomPercent) / 100).",
  "type": "object",
  "required": [
    "schema",
    "note",
    "method",
    "planning",
    "tagLists",
    "profiles",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "efs-gas-model/1"
    },
    "note": {
      "type": "string"
    },
    "method": {
      "type": "object",
      "required": [
        "suite",
        "prague",
        "amsterdam",
        "measurement",
        "marginal",
        "slopes",
        "fixed",
        "tagLevels"
      ]
    },
    "profiles": {
      "type": "object",
      "required": [
        "prague"
      ],
      "properties": {
        "prague": {
          "type": "object",
          "required": [
            "quantity",
            "constants",
            "fit",
            "floor",
            "rows",
            "validation",
            "maxAbsErrorPercent"
          ],
          "properties": {
            "constants": {
              "type": "object",
              "required": [
                "fixed",
                "perWord",
                "perByte",
                "publishNew",
                "publishExisting",
                "reuse",
                "create",
                "bindHeadFresh",
                "bindHeadRebind",
                "bindFolderFreshFile",
                "bindFolderFreshDirectory",
                "bindFolderRebind",
                "unbindFolder",
                "releaseFolder",
                "bindTagFresh",
                "bindTagSecondAuthor",
                "bindTagNumberChange",
                "unbindTagLone",
                "unbindTag",
                "releaseTag",
                "restoreTag",
                "withdraw",
                "firstWriteSurcharge",
                "tagLevel"
              ],
              "properties": {
                "fixed": {
                  "type": "integer"
                },
                "perWord": {
                  "type": "integer"
                },
                "perByte": {
                  "type": "number"
                },
                "publishNew": {
                  "type": "object",
                  "required": [
                    "files-bytes/1"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "publishExisting": {
                  "type": "integer"
                },
                "reuse": {
                  "type": "integer"
                },
                "create": {
                  "type": "integer"
                },
                "bindHeadFresh": {
                  "type": "integer"
                },
                "bindHeadRebind": {
                  "type": "integer"
                },
                "bindFolderFreshFile": {
                  "type": "integer"
                },
                "bindFolderFreshDirectory": {
                  "type": "integer"
                },
                "bindFolderRebind": {
                  "type": "integer"
                },
                "unbindFolder": {
                  "type": "integer"
                },
                "releaseFolder": {
                  "type": "integer"
                },
                "bindTagFresh": {
                  "type": "integer"
                },
                "bindTagSecondAuthor": {
                  "type": "integer"
                },
                "bindTagNumberChange": {
                  "type": "integer"
                },
                "unbindTagLone": {
                  "type": "integer"
                },
                "withdraw": {
                  "type": "integer"
                },
                "firstWriteSurcharge": {
                  "type": "integer"
                },
                "tagLevel": {
                  "type": "object",
                  "description": "Per proper ancestor of a first TAG statement's topic (design \u00a710.4): mineNew/mineExisting for the author's scope-below list at that ancestor, sharedNew/sharedExisting for the place-below list (written only on a fresh position).",
                  "required": [
                    "mineNew",
                    "mineExisting",
                    "sharedNew",
                    "sharedExisting"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "unbindTag": {
                  "type": "integer"
                },
                "releaseTag": {
                  "type": "integer"
                },
                "restoreTag": {
                  "type": "integer"
                }
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "test",
                  "gas",
                  "frameGas",
                  "kernelFrameGas"
                ]
              }
            },
            "validation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "what",
                  "measured",
                  "predicted",
                  "errorPercent",
                  "measuredKernelGas",
                  "predictedKernelGas"
                ]
              }
            },
            "maxAbsErrorPercent": {
              "type": "number"
            },
            "floor": {
              "type": "object",
              "description": "The kernel's index-floor inputs on this schedule, exactly (design \u00a710.4), and the kernel's own execution gas (`kernel`: the constants' structure, fitted from the rows' kernel frame gas, the index's callbacks answered by vm.mockCall).",
              "required": [
                "formula",
                "quantity",
                "workModel",
                "limits",
                "callGasRetained",
                "dispatchOverhead",
                "types",
                "kernel"
              ],
              "properties": {
                "formula": {
                  "type": "string"
                },
                "workModel": {
                  "type": "object",
                  "required": [
                    "formulaVersion",
                    "freshPerPublication",
                    "rwPerPublication",
                    "freshPerPublishFresh",
                    "rwPerPublish",
                    "freshPerBindFresh",
                    "rwPerBind",
                    "freshPerRef",
                    "freshPerDigestSpec",
                    "computeBase",
                    "computePerAction",
                    "computePerHookEffect",
                    "finalComputeBase",
                    "finalComputePerBind"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "limits": {
                  "type": "object",
                  "required": [
                    "floorFreshGas",
                    "floorRewriteGas",
                    "kernelTail"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "callGasRetained": {
                  "type": "object",
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "dispatchOverhead": {
                  "type": "integer"
                },
                "types": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "refs",
                      "specs"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                },
                "kernel": {
                  "type": "object",
                  "required": [
                    "fixed",
                    "perWord",
                    "perByte",
                    "publishNew",
                    "publishExisting",
                    "reuse",
                    "create",
                    "firstWriteSurcharge",
                    "tagLevel"
                  ]
                }
              }
            }
          }
        },
        "amsterdam": {
          "type": "object",
          "required": [
            "quantity",
            "constants",
            "split",
            "fit",
            "floor",
            "rows",
            "validation",
            "maxAbsErrorPercent"
          ],
          "properties": {
            "split": {
              "type": "object",
              "required": [
                "executionGas",
                "stateGas",
                "note"
              ]
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "test",
                  "gas",
                  "frameGas",
                  "kernelFrameGas"
                ]
              }
            },
            "validation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "what",
                  "measured",
                  "predicted",
                  "errorPercent",
                  "measuredExecutionGas",
                  "predictedExecutionGas",
                  "measuredStateGas",
                  "predictedStateGas",
                  "measuredKernelGas",
                  "predictedKernelGas"
                ]
              }
            },
            "maxAbsErrorPercent": {
              "type": "number"
            },
            "floor": {
              "type": "object",
              "description": "The kernel's index-floor inputs on this schedule, exactly (design \u00a710.4), and the kernel's own execution gas (`kernel`: the constants' structure, fitted from the rows' kernel frame gas, the index's callbacks answered by vm.mockCall).",
              "required": [
                "formula",
                "quantity",
                "workModel",
                "limits",
                "callGasRetained",
                "dispatchOverhead",
                "types",
                "kernel"
              ],
              "properties": {
                "formula": {
                  "type": "string"
                },
                "workModel": {
                  "type": "object",
                  "required": [
                    "formulaVersion",
                    "freshPerPublication",
                    "rwPerPublication",
                    "freshPerPublishFresh",
                    "rwPerPublish",
                    "freshPerBindFresh",
                    "rwPerBind",
                    "freshPerRef",
                    "freshPerDigestSpec",
                    "computeBase",
                    "computePerAction",
                    "computePerHookEffect",
                    "finalComputeBase",
                    "finalComputePerBind"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "limits": {
                  "type": "object",
                  "required": [
                    "floorFreshGas",
                    "floorRewriteGas",
                    "kernelTail"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "callGasRetained": {
                  "type": "object",
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "dispatchOverhead": {
                  "type": "integer"
                },
                "types": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "refs",
                      "specs"
                    ],
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                },
                "kernel": {
                  "type": "object",
                  "required": [
                    "fixed",
                    "perWord",
                    "perByte",
                    "publishNew",
                    "publishExisting",
                    "reuse",
                    "create",
                    "firstWriteSurcharge",
                    "tagLevel"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "test",
        "commit",
        "date"
      ]
    },
    "planning": {
      "type": "object",
      "description": "The planning rule (tools/gas-plan.mjs is its reference implementation, reading only this file).",
      "required": [
        "rule",
        "txGasCap",
        "txGasCapRule",
        "headroomPercent",
        "headroomCovers",
        "limits"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "txGasCap": {
          "type": "integer"
        },
        "headroomPercent": {
          "type": "integer"
        },
        "limits": {
          "type": "object",
          "required": [
            "maxActions",
            "maxBindsPerPublication",
            "maxBodyBytesPerPublication"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "tagLists": {
      "type": "object",
      "description": "When a roll-up list's next append is priced as new (tagLevel.mineNew / sharedNew): entries \u2208 priceAsNew.entries or entries % priceAsNew.entriesMultipleOf == 0.",
      "required": [
        "priceAsNew",
        "note"
      ],
      "properties": {
        "priceAsNew": {
          "type": "object",
          "required": [
            "entries",
            "entriesMultipleOf"
          ],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "entriesMultipleOf": {
              "type": "integer"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
