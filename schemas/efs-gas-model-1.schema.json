{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "efs-gas-model/1",
  "title": "efs-gas-model/1 \u2014 a per-action gas model of one native-lane publication",
  "description": "Written by tools/gas-model.mjs from test/integration/GasModel.t.sol. gas(publication) = fixed + \u03a3 cost(action); PUBLISH new = publishNew[shape] + perWord\u00b7ceil(n/32) + perByte\u00b7n; a first TAG on an n-word topic adds tagLevel terms per proper ancestor. Planning only: eth_estimateGas stays the authority before sending. Excludes intrinsic, calldata and refunds.",
  "type": "object",
  "required": [
    "schema",
    "note",
    "method",
    "profiles",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "efs-gas-model/1"
    },
    "note": {
      "type": "string"
    },
    "method": {
      "type": "object",
      "required": [
        "suite",
        "prague",
        "amsterdam",
        "measurement",
        "marginal",
        "slopes",
        "fixed",
        "tagLevels"
      ]
    },
    "profiles": {
      "type": "object",
      "required": [
        "prague"
      ],
      "properties": {
        "prague": {
          "type": "object",
          "required": [
            "quantity",
            "constants",
            "fit",
            "rows",
            "validation",
            "maxAbsErrorPercent"
          ],
          "properties": {
            "constants": {
              "type": "object",
              "required": [
                "fixed",
                "perWord",
                "perByte",
                "publishNew",
                "publishExisting",
                "reuse",
                "create",
                "bindHeadFresh",
                "bindHeadRebind",
                "bindFolderFreshFile",
                "bindFolderFreshDirectory",
                "bindFolderRebind",
                "unbindFolder",
                "releaseFolder",
                "bindTagFresh",
                "bindTagSecondAuthor",
                "bindTagNumberChange",
                "unbindTagLone",
                "withdraw",
                "firstWriteSurcharge",
                "tagLevel"
              ],
              "properties": {
                "fixed": {
                  "type": "integer"
                },
                "perWord": {
                  "type": "integer"
                },
                "perByte": {
                  "type": "number"
                },
                "publishNew": {
                  "type": "object",
                  "required": [
                    "files-bytes/1"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "publishExisting": {
                  "type": "integer"
                },
                "reuse": {
                  "type": "integer"
                },
                "create": {
                  "type": "integer"
                },
                "bindHeadFresh": {
                  "type": "integer"
                },
                "bindHeadRebind": {
                  "type": "integer"
                },
                "bindFolderFreshFile": {
                  "type": "integer"
                },
                "bindFolderFreshDirectory": {
                  "type": "integer"
                },
                "bindFolderRebind": {
                  "type": "integer"
                },
                "unbindFolder": {
                  "type": "integer"
                },
                "releaseFolder": {
                  "type": "integer"
                },
                "bindTagFresh": {
                  "type": "integer"
                },
                "bindTagSecondAuthor": {
                  "type": "integer"
                },
                "bindTagNumberChange": {
                  "type": "integer"
                },
                "unbindTagLone": {
                  "type": "integer"
                },
                "withdraw": {
                  "type": "integer"
                },
                "firstWriteSurcharge": {
                  "type": "integer"
                },
                "tagLevel": {
                  "type": "object",
                  "description": "Per proper ancestor of a first TAG statement's topic (design \u00a710.4): mineNew/mineExisting for the author's scope-below list at that ancestor, sharedNew/sharedExisting for the place-below list (written only on a fresh position).",
                  "required": [
                    "mineNew",
                    "mineExisting",
                    "sharedNew",
                    "sharedExisting"
                  ],
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "test",
                  "gas",
                  "frameGas"
                ]
              }
            },
            "validation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "what",
                  "measured",
                  "predicted",
                  "errorPercent"
                ]
              }
            },
            "maxAbsErrorPercent": {
              "type": "number"
            }
          }
        },
        "amsterdam": {
          "type": "object",
          "required": [
            "quantity",
            "constants",
            "split",
            "fit",
            "rows",
            "validation",
            "maxAbsErrorPercent"
          ],
          "properties": {
            "split": {
              "type": "object",
              "required": [
                "executionGas",
                "stateGas",
                "note"
              ]
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "test",
                  "gas",
                  "frameGas"
                ]
              }
            },
            "validation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "what",
                  "measured",
                  "predicted",
                  "errorPercent",
                  "measuredExecutionGas",
                  "predictedExecutionGas",
                  "measuredStateGas",
                  "predictedStateGas"
                ]
              }
            },
            "maxAbsErrorPercent": {
              "type": "number"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "test",
        "commit",
        "date"
      ]
    },
    "reads": {
      "type": "object",
      "description": "The topic readers' read terms and call bounds (tools/gas-reads.mjs from test/integration/TopicReadMeasure.t.sol; docs/TAG-NUMBERS.md \"Reads\"). Written by every run of tools/gas-model.mjs; its own top-level section beside the publication model.",
      "required": [
        "note",
        "suite",
        "callGasCap",
        "marginPercent",
        "method",
        "schedules"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "suite": {
          "type": "string"
        },
        "callGasCap": {
          "type": "integer"
        },
        "marginPercent": {
          "type": "integer"
        },
        "method": {
          "type": "object",
          "required": [
            "measurement",
            "mine",
            "everyone",
            "bounds",
            "recommended"
          ]
        },
        "schedules": {
          "type": "object",
          "required": [
            "prague"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "rows",
              "terms",
              "bounds",
              "recommended"
            ],
            "properties": {
              "rows": {
                "type": "object",
                "description": "every measured \"tr <key>\" row of the suite: one cold view call, gas",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "terms": {
                "type": "object",
                "required": [
                  "mineExact",
                  "mineBelow",
                  "everyoneExact",
                  "everyoneBelow",
                  "rawExact",
                  "rawBelow",
                  "byName",
                  "about",
                  "wordPage",
                  "children"
                ],
                "properties": {
                  "mineExact": {
                    "type": "object",
                    "required": [
                      "opening",
                      "openingPerLensAuthor",
                      "perRow",
                      "perLensIndex",
                      "maxAbsErrorPercent"
                    ]
                  },
                  "mineBelow": {
                    "type": "object",
                    "required": [
                      "opening",
                      "openingPerLensAuthor",
                      "perRow",
                      "perLensIndex",
                      "maxAbsErrorPercent"
                    ]
                  },
                  "everyoneExact": {
                    "type": "object",
                    "required": [
                      "opening",
                      "perRow",
                      "perLensAuthor",
                      "perSkippedEntryByLens"
                    ]
                  },
                  "everyoneBelow": {
                    "type": "object",
                    "required": [
                      "opening",
                      "perRow",
                      "perLensAuthor",
                      "perSkippedEntryByLens"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "opening",
                    "perRow"
                  ]
                }
              },
              "bounds": {
                "type": "object",
                "description": "per lens size: the most rows (worst case) and skipped entries one call reads under the budget",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "mineExact",
                    "mineBelow",
                    "everyoneExact",
                    "everyoneBelow"
                  ]
                }
              },
              "recommended": {
                "type": "object",
                "required": [
                  "pageTimesLens",
                  "maxRows",
                  "limitEntries"
                ]
              }
            }
          }
        }
      }
    }
  }
}
